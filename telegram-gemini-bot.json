        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [ { text: 'Transcribe this voice note exactly. Return only the transcript, nothing else.' }, { inline_data: { mime_type: $json.mime, data: $json.audio } } ] }] }) }}",
        "options": {}
