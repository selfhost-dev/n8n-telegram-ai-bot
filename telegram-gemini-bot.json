    },
    {
      "parameters": {
        "jsCode": "// Bot username without the @\nconst BOT = 'srushti_n8n_gemini_bot';\n\nconst m = $('Telegram Trigger').first().json.message;\nlet text = m.text || '';\nlet inputType = 'text';\n\nif (m.voice) {\n  const g = $input.first().json;\n  const parts = (g.candidates && g.candidates[0] && g.candidates[0].content && g.candidates[0].content.parts) || [];\n  text = parts.map(x => x.text || '').join('').trim();\n  inputType = 'voice';\n}\n\nconst isGroup = ['group', 'supergroup'].includes(m.chat.type);\nconst mentioned = text.toLowerCase().includes('@' + BOT.toLowerCase());\nconst repliedToBot = !!(m.reply_to_message && m.reply_to_message.from && m.reply_to_message.from.is_bot);\n\n// Private chat: always answer. Group: only when mentioned or replied to.\nconst shouldReply = !isGroup || mentioned || repliedToBot;\n\nreturn [{ json: {\n  chatId: m.chat.id,\n  text: text.replace(new RegExp('@' + BOT, 'ig'), '').trim(),\n  inputType,\n  isGroup,\n  shouldReply\n} }];"
      },
      "name": "Prepare message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        48
      ],
      "id": "6f25cd75-e1dc-456b-834b-a561b52a39f8"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
