              "id": "should-reply",
              "leftValue": "={{ $json.shouldReply }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "has-text",
              "leftValue": "={{ $json.text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Should I reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        624,
        48
      ],
      "id": "77515432-8791-4e93-ab8f-c725b8539de2"
    },
    {
      "parameters": {
        "jsCode": "const p = $('Prepare message').first().json;\nconst data = $getWorkflowStaticData('global');\ndata.history = data.history || {};\nconst hist = data.history[String(p.chatId)] || [];\n\nlet contents = [...hist, { role: 'user', parts: [{ text: p.text }] }].slice(-6);\nwhile (contents.length > 1 && contents[0].role !== 'user') contents.shift();\n\nconst body = {\n  systemInstruction: { parts: [{ text: 'You are a friendly, concise assistant inside Telegram. Answer in the same language the user writes in. Keep replies under 120 words unless asked for more. If the message came from a voice note, answer naturally as if spoken to. Do not ask for or store private data.' }] },\n  contents\n};\n\nreturn [{ json: { chatId: p.chatId, userText: p.text, body } }];"
      },
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        -32
      ],
      "id": "22a0a623-7ca5-4abd-b54d-63ae1f9cc44f"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
