      "name": "Gemini reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1072,
        -32
      ],
      "id": "d1c5db7d-0d30-45b2-b5cd-4e10f899b73b",
      "retryOnFail": true,
