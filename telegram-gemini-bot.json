      "name": "Gemini transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        192,
        -80
      ],
      "id": "feea4bcd-f20a-40ac-a0a3-bca43b7a80aa",
      "credentials": {
        "httpHeaderAuth": {
          "id": "wnj930w3GLwcwVO0",
          "name": "Header Auth account"
        }
