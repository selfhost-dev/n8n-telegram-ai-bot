      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "wnj930w3GLwcwVO0",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\nconst p = $('Build request').first().json;\nconst parts = ($json.candidates && $json.candidates[0] && $json.candidates[0].content && $json.candidates[0].content.parts) || [];\nconst reply = parts.filter(x => !x.thought).map(x => x.text || '').join('').trim() || 'Sorry, I could not come up with an answer.';\n\nconst key = String(p.chatId);\ndata.history = data.history || {};\nconst hist = data.history[key] || [];\nhist.push({ role: 'user', parts: [{ text: p.userText }] });\nhist.push({ role: 'model', parts: [{ text: reply }] });\ndata.history[key] = hist.slice(-6);\n\nreturn [{ json: { chatId: p.chatId, reply } }];"
      },
